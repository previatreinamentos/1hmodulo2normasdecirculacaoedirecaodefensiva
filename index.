    function showSlide(slideIndex) {
        if (slideIndex < 1 || slideIndex > totalSlides) return;
        
        stopAudio();

        for (let i = 1; i <= totalSlides; i++) {
            const slide = document.getElementById(`slide-${i}`);
            if (slide) {
                slide.classList.add('opacity-0', 'pointer-events-none', 'translate-x-12');
                slide.classList.remove('opacity-100', 'pointer-events-auto', 'translate-x-0');
            }
        }

        const target = document.getElementById(`slide-${slideIndex}`);
        if (target) {
            target.classList.remove('opacity-0', 'pointer-events-none', 'translate-x-12');
            target.classList.add('opacity-100', 'pointer-events-auto', 'translate-x-0');
        }

        currentSlide = slideIndex;

        document.getElementById('current-slide-num').innerText = currentSlide;
        document.getElementById('slide-dropdown-select').value = currentSlide;

        document.getElementById('prev-btn').disabled = (currentSlide === 1);
        const nextBtn = document.getElementById('next-btn');
        if (currentSlide === totalSlides) {
            nextBtn.innerHTML = 'Concluir <i class="fa-solid fa-check"></i>';
        } else {
            nextBtn.innerHTML = 'Próximo <i class="fa-solid fa-chevron-right"></i>';
        }

        updateProgressBar();
    }

    function nextSlide() {
        if (currentSlide < totalSlides) {
            showSlide(currentSlide + 1);
        }
    }

    function prevSlide() {
        if (currentSlide > 1) {
            showSlide(currentSlide - 1);
        }
    }

    function jumpToSlide(index) {
        showSlide(parseInt(index));
    }

    function buildProgressBar() {
        const container = document.getElementById('progress-bar-container');
        container.innerHTML = '';
        for (let i = 1; i <= totalSlides; i++) {
            const seg = document.createElement('div');
            seg.className = 'flex-1 h-1.5 rounded-full bg-slate-200 cursor-pointer progress-segment';
            seg.title = `Ir para slide ${i}`;
            seg.onclick = () => jumpToSlide(i);
            seg.id = `p-seg-${i}`;
            container.appendChild(seg);
        }
    }

    function updateProgressBar() {
        for (let i = 1; i <= totalSlides; i++) {
            const seg = document.getElementById(`p-seg-${i}`);
            if (seg) {
                if (i === currentSlide) {
                    seg.className = 'flex-1 h-2 rounded-full bg-previa-teal progress-segment active';
                } else if (i < currentSlide) {
                    seg.className = 'flex-1 h-1.5 rounded-full bg-previa-tealLight opacity-80 progress-segment completed';
                } else {
                    seg.className = 'flex-1 h-1.5 rounded-full bg-slate-200 progress-segment';
                }
            }
        }
    }

