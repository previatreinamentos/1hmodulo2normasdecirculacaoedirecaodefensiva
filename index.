<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PREVIA - Módulo 2: Normas de Circulação e Direção Defensiva</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        previa: {
                            navy: '#1e252b',        /* Azul Escuro Principal */
                            navyDark: '#12181c',    /* Fundo geral escuro */
                            teal: '#00848c',        /* Azul Turquesa / Teal */
                            tealLight: '#00a9b4',  /* Teal Ativo */
                            orange: '#ff823a',      /* Laranja de Destaque */
                            white: '#ffffff',
                            slate: '#334155',
                            grayLight: '#f8fafc',
                            border: '#e2e8f0'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        title: ['Poppins', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --font-scale: 1.0;
            --bg-gradient-start: #1e252b;
            --bg-gradient-via: #161c20;
            --bg-gradient-end: #0f1316;
            --text-primary: #ffffff;
            --text-secondary: #cbd5e1;
            --card-bg: rgba(255, 255, 255, 0.05);
            --card-border: rgba(255, 255, 255, 0.1);
        }

        .light-theme {
            --bg-gradient-start: #f8fafc;
            --bg-gradient-via: #f1f5f9;
            --bg-gradient-end: #e2e8f0;
            --text-primary: #1e252b;
            --text-secondary: #475569;
            --card-bg: #ffffff;
            --card-border: #cbd5e1;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-gradient-end);
            user-select: none;
            transition: background-color 0.3s ease;
        }

        .scaled-text-p {
            font-size: calc(0.875rem * var(--font-scale)) !important;
            line-height: 1.6;
        }
        .scaled-text-h2 {
            font-size: calc(1.75rem * var(--font-scale)) !important;
            line-height: 1.2;
        }
        .scaled-text-h3 {
            font-size: calc(1.15rem * var(--font-scale)) !important;
        }
        .scaled-text-xs {
            font-size: calc(0.75rem * var(--font-scale)) !important;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #00848c;
            border-radius: 3px;
        }

        .progress-segment {
            transition: all 0.3s ease;
        }
        .progress-segment.active {
            background-color: #00848c;
        }
        .progress-segment.completed {
            background-color: #00a9b4;
            opacity: 0.8;
        }
    </style>
</head>
<body class="w-screen h-screen overflow-hidden m-0 p-0 flex flex-col justify-between">

<div id="presentation-wrapper" class="w-full h-full bg-previa-navy flex flex-col justify-between relative overflow-hidden transition-all duration-300">
    
    <!-- CABEÇALHO DA INTERFACE -->
    <header class="h-[75px] bg-white text-previa-navy px-4 md:px-6 flex items-center justify-between border-b-2 border-previa-border shrink-0 z-20">
        <div class="flex items-center gap-3">
            <div class="bg-previa-teal text-white font-title font-extrabold text-base md:text-lg px-3 md:px-4 py-1.5 rounded-lg tracking-wider">PREVIA</div>
            <div class="flex flex-col">
                <span class="text-[10px] md:text-xs font-bold text-previa-teal tracking-wide uppercase">Curso Teórico de Primeira Habilitação</span>
                <span class="text-[10px] md:text-xs text-slate-500 font-medium">Módulo 2: Normas de Circulação e Direção Defensiva</span>
            </div>
        </div>
        
        <div class="flex items-center gap-2 md:gap-3">
            <!-- Controles Acessibilidade -->
            <div class="hidden sm:flex items-center gap-1 bg-slate-100 border border-slate-200 rounded-lg px-2 py-1">
                <button onclick="changeFontSize(-0.1)" class="w-6 h-6 flex items-center justify-center text-slate-600 hover:text-previa-teal font-bold text-xs" title="Diminuir Fonte">A-</button>
                <button onclick="changeFontSize(0.1)" class="w-6 h-6 flex items-center justify-center text-slate-600 hover:text-previa-teal font-bold text-xs" title="Aumentar Fonte">A+</button>
                <button onclick="toggleTheme()" class="w-6 h-6 flex items-center justify-center text-slate-600 hover:text-previa-teal text-xs ml-1" title="Alternar Tema Light/Dark">
                    <i class="fa-solid fa-circle-half-stroke"></i>
                </button>
            </div>

            <!-- Dropdown indicador do topo -->
            <select id="slide-dropdown-select" onchange="jumpToSlide(parseInt(this.value))" class="bg-slate-100 border border-slate-200 text-slate-700 text-xs font-semibold px-2 md:px-3 py-1.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-previa-teal cursor-pointer max-w-[130px] md:max-w-none">
                <!-- Injetado via JS -->
            </select>

            <!-- Seletor de Velocidade do Áudio -->
            <div class="flex items-center gap-1 bg-slate-100 border border-slate-200 rounded-lg px-2 py-1">
                <i class="fa-solid fa-gauge-high text-xs text-slate-500" title="Velocidade"></i>
                <select id="audio-rate-select" onchange="setAudioRate(parseFloat(this.value))" class="bg-transparent text-slate-700 text-xs font-semibold focus:outline-none cursor-pointer">
                    <option value="0.75">0.75x</option>
                    <option value="1.0" selected>1.0x</option>
                    <option value="1.25">1.25x</option>
                    <option value="1.5">1.5x</option>
                    <option value="2.0">2.0x</option>
                </select>
            </div>

            <!-- Botão de Áudio e Narração -->
            <button id="audio-btn" onclick="toggleAudio()" class="w-10 h-10 rounded-full bg-slate-100 hover:bg-previa-teal hover:text-white border border-slate-200 flex items-center justify-center cursor-pointer transition-all duration-300 text-slate-700 relative" title="Ouvir Narração do Slide">
                <i class="fa-solid fa-volume-high text-sm" id="audio-icon"></i>
                <span id="audio-pulse" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-previa-orange rounded-full animate-ping"></span>
            </button>
        </div>
    </header>

    <div class="bg-white px-6 pb-2 pt-1 flex gap-1 z-10 shrink-0 border-b border-slate-100" id="progress-bar-container">
        <!-- Gerado dinamicamente via JS -->
    </div>

    <div id="slides-viewport" class="flex-1 relative overflow-hidden bg-gradient-to-br from-[#1e252b] via-[#161c20] to-[#0f1316] transition-all duration-300">
        
        <!-- SLIDE 1: CAPA PRINCIPAL DO MÓDULO 2 -->
        <div class="slide-layout absolute inset-0 p-6 md:p-12 flex flex-col justify-center opacity-0 pointer-events-none transition-all duration-500 transform translate-x-12" id="slide-1">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center h-full">
                <div class="space-y-6">
                    <div class="flex items-center gap-3 flex-wrap">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-previa-orange/10 border border-previa-orange/20 text-previa-orange text-xs font-semibold uppercase tracking-wider">
                            <i class="fa-solid fa-graduation-cap"></i> CNH do Brasil - Módulo 2
                        </div>
                        <button onclick="toggleAudio()" class="slide-audio-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-previa-teal/20 text-previa-tealLight border border-previa-teal/30 hover:bg-previa-teal hover:text-white transition-all text-xs font-semibold cursor-pointer">
                            <i class="fa-solid fa-volume-high"></i> Ouvir Áudio
                        </button>
                    </div>
                    <h1 class="text-3xl md:text-5xl font-title font-extrabold text-[var(--text-primary)] leading-tight">
                        Normas de Circulação &<br><span class="text-previa-tealLight">Direção Defensiva</span>
                    </h1>
                    <p class="text-[var(--text-secondary)] scaled-text-p max-w-md">
                        Aprenda as regras essenciais do Código de Trânsito Brasileiro (CTB) e as técnicas indispensáveis para prever riscos, evitar acidentes e conduzir com máxima segurança nas vias.
                    </p>
                </div>
                <div class="hidden lg:flex flex-col items-center justify-center p-6 bg-black/20 rounded-2xl border border-white/10">
                    <div class="w-full max-w-md h-64 bg-slate-800/80 rounded-xl border border-previa-teal/30 flex flex-col items-center justify-center p-6 text-center shadow-2xl relative overflow-hidden">
                        <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-previa-teal/10 rounded-full blur-2xl"></div>
                        <i class="fa-solid fa-shield-halved text-6xl text-previa-tealLight mb-4 animate-bounce"></i>
                        <h3 class="font-title font-bold text-white text-xl">Condução Segura e Prevenção</h3>
                        <p class="text-slate-400 text-xs mt-2">Segurança em primeiro lugar para motoristas e pedestres</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SLIDE 2: CONCEITO DE DIREÇÃO DEFENSIVA -->
        <div class="slide-layout absolute inset-0 p-6 md:p-12 flex flex-col justify-center opacity-0 pointer-events-none transition-all duration-500 transform translate-x-12" id="slide-2">
            <div class="flex items-center justify-between mb-2">
                <h2 class="scaled-text-h2 font-title font-bold text-[var(--text-primary)]">O Conceito de <span class="text-previa-tealLight">Direção Defensiva</span></h2>
                <button onclick="toggleAudio()" class="slide-audio-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-previa-teal/20 text-previa-tealLight border border-previa-teal/30 hover:bg-previa-teal hover:text-white transition-all text-xs font-semibold cursor-pointer">
                    <i class="fa-solid fa-volume-high"></i> Ouvir Áudio
                </button>
            </div>
            <p class="text-[var(--text-secondary)] scaled-text-p max-w-3xl mb-6">
                Dirigir defensivamente é dirigir de modo a evitar acidentes, apesar das ações incorretas dos outros condutores e das condições adversas encontradas nas vias.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-[var(--card-bg)] border border-[var(--card-border)] p-6 rounded-2xl flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-previa-teal/20 text-previa-tealLight flex items-center justify-center text-xl shrink-0">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <h3 class="scaled-text-h3 font-title font-bold text-[var(--text-primary)] mb-2">Direção Preventiva</h3>
                        <p class="text-slate-300 scaled-text-p">O condutor antecipa as situações de risco, avalia o ambiente constantemente e adota atitudes cautelosas antes que o perigo se materialize. <strong class="text-previa-tealLight">É a forma ideal de condução.</strong></p>
                    </div>
                </div>
                <div class="bg-[var(--card-bg)] border border-[var(--card-border)] p-6 rounded-2xl flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-previa-orange/20 text-previa-orange flex items-center justify-center text-xl shrink-0">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h3 class="scaled-text-h3 font-title font-bold text-[var(--text-primary)] mb-2">Direção Corretiva</h3>
                        <p class="text-slate-300 scaled-text-p">O condutor precisa agir sob pressão para corrigir uma situação de perigo já instalada por falta de planejamento ou surpresa. <strong class="text-previa-orange">Exige alto reflexo e nem sempre evita o acidente.</strong></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SLIDE 3: OS 5 ELEMENTOS DA DIREÇÃO DEFENSIVA -->
        <div class="slide-layout absolute inset-0 p-6 md:p-12 flex flex-col justify-center opacity-0 pointer-events-none transition-all duration-500 transform translate-x-12" id="slide-3">
            <div class="flex items-center justify-between mb-2">
                <h2 class="scaled-text-h2 font-title font-bold text-[var(--text-primary)]">Os 5 Pilares Fundamentais</h2>
                <button onclick="toggleAudio()" class="slide-audio-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-previa-teal/20 text-previa-tealLight border border-previa-teal/30 hover:bg-previa-teal hover:text-white transition-all text-xs font-semibold cursor-pointer">
                    <i class="fa-solid fa-volume-high"></i> Ouvir Áudio
                </button>
            </div>
            <p class="text-[var(--text-secondary)] scaled-text-p max-w-2xl mb-6">Para dirigir de forma segura, todo condutor precisa dominar cinco elementos essenciais:</p>
            
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3 md:gap-4 overflow-y-auto max-h-[380px] pr-2 custom-scrollbar">
                <div class="p-4 bg-[var(--card-bg)] rounded-xl border border-[var(--card-border)] flex flex-col justify-between">
                    <div>
                        <span class="text-previa-tealLight text-2xl inline-block mb-2"><i class="fa-solid fa-book-open"></i></span>
                        <h4 class="font-title font-bold text-xs md:text-sm text-[var(--text-primary)]">1. Conhecimento</h4>
                    </div>
                    <p class="text-slate-400 text-[11px] mt-2">Leis de trânsito, regras da via e mecânica básica do veículo.</p>
                </div>
                <div class="p-4 bg-[var(--card-bg)] rounded-xl border border-[var(--card-border)] flex flex-col justify-between">
                    <div>
                        <span class="text-previa-tealLight text-2xl inline-block mb-2"><i class="fa-solid fa-eye"></i></span>
                        <h4 class="font-title font-bold text-xs md:text-sm text-[var(--text-primary)]">2. Atenção</h4>
                    </div>
                    <p class="text-slate-400 text-[11px] mt-2">Foco total no trânsito, retrovisores e arredores sem distrações.</p>
                </div>
                <div class="p-4 bg-[var(--card-bg)] rounded-xl border border-[var(--card-border)] flex flex-col justify-between">
                    <div>
                        <span class="text-previa-tealLight text-2xl inline-block mb-2"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                        <h4 class="font-title font-bold text-xs md:text-sm text-[var(--text-primary)]">3. Previsão</h4>
                    </div>
                    <p class="text-slate-400 text-[11px] mt-2">Antecipar o que pode dar errado antes de chegar ao local.</p>
                </div>
                <div class="p-4 bg-[var(--card-bg)] rounded-xl border border-[var(--card-border)] flex flex-col justify-between">
                    <div>
                        <span class="text-previa-tealLight text-2xl inline-block mb-2"><i class="fa-solid fa-bolt-lightning"></i></span>
                        <h4 class="font-title font-bold text-xs md:text-sm text-[var(--text-primary)]">4. Decisão</h4>
                    </div>
                    <p class="text-slate-400 text-[11px] mt-2">Escolher a ação mais segura e correta no menor tempo possível.</p>
                </div>
                <div class="p-4 bg-[var(--card-bg)] rounded-xl border border-[var(--card-border)] flex flex-col justify-between col-span-2 md:col-span-1">
                    <div>
                        <span class="text-previa-tealLight text-2xl inline-block mb-2"><i class="fa-solid fa-hand-holding-steering-wheel"></i></span>
                        <h4 class="font-title font-bold text-xs md:text-sm text-[var(--text-primary)]">5. Habilidade</h4>
                    </div>
                    <p class="text-slate-400 text-[11px] mt-2">Capacidade técnica de manusear os comandos do veículo com precisão.</p>
                </div>
            </div>
        </div>

        <!-- SLIDE 4: NORMAS GERAIS DE CIRCULAÇÃO E PREFERÊNCIAS -->
        <div class="slide-layout absolute inset-0 p-6 md:p-12 flex flex-col justify-center opacity-0 pointer-events-none transition-all duration-500 transform translate-x-12" id="slide-4">
            <div class="flex items-center justify-between mb-2">
                <h2 class="scaled-text-h2 font-title font-bold text-[var(--text-primary)]">Normas de Circulação e <span class="text-previa-tealLight">Preferências</span></h2>
                <button onclick="toggleAudio()" class="slide-audio-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-previa-teal/20 text-previa-tealLight border border-previa-teal/30 hover:bg-previa-teal hover:text-white transition-all text-xs font-semibold cursor-pointer">
                    <i class="fa-solid fa-volume-high"></i> Ouvir Áudio
                </button>
            </div>
            <p class="text-[var(--text-secondary)] scaled-text-p mb-6">Em cruzamentos não sinalizados, quem tem a preferência de passagem?</p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-[var(--card-bg)] border border-[var(--card-border)] p-5 rounded-2xl flex flex-col items-center text-center">
                    <div class="w-16 h-16 rounded-full bg-previa-teal/20 text-previa-tealLight flex items-center justify-center text-2xl mb-3">
                        <i class="fa-solid fa-road"></i>
                    </div>
                    <h3 class="scaled-text-h3 font-title font-bold text-[var(--text-primary)]">1. Rodovias</h3>
                    <p class="text-slate-300 scaled-text-xs mt-2 leading-relaxed">Tem preferência quem estiver circulando pela <strong>rodovia</strong> sobre quem for entrar nela.</p>
                    <span class="mt-4 px-3 py-1 bg-previa-teal/20 text-previa-tealLight rounded-full text-[11px] font-semibold">Prioridade Absoluta</span>
                </div>
                <div class="bg-[var(--card-bg)] border border-[var(--card-border)] p-5 rounded-2xl flex flex-col items-center text-center">
                    <div class="w-16 h-16 rounded-full bg-previa-orange/20 text-previa-orange flex items-center justify-center text-2xl mb-3">
                        <i class="fa-solid fa-rotate-right"></i>
                    </div>
                    <h3 class="scaled-text-h3 font-title font-bold text-[var(--text-primary)]">2. Rotatória</h3>
                    <p class="text-slate-300 scaled-text-xs mt-2 leading-relaxed">Tem preferência quem já estiver <strong>circulando</strong> no anel da rotatória.</p>
                    <span class="mt-4 px-3 py-1 bg-previa-orange/20 text-previa-orange rounded-full text-[11px] font-semibold">Regra do Anel</span>
                </div>
                <div class="bg-[var(--card-bg)] border border-[var(--card-border)] p-5 rounded-2xl flex flex-col items-center text-center">
                    <div class="w-16 h-16 rounded-full bg-yellow-500/20 text-yellow-400 flex items-center justify-center text-2xl mb-3">
                        <i class="fa-solid fa-arrow-turn-right"></i>
                    </div>
                    <h3 class="scaled-text-h3 font-title font-bold text-[var(--text-primary)]">3. Regra da Direita</h3>
                    <p class="text-slate-300 scaled-text-xs mt-2 leading-relaxed">Nos demais cruzamentos sem sinalização, a preferência é do veículo vindo pela <strong>direita</strong>.</p>
                    <span class="mt-4 px-3 py-1 bg-yellow-500/20 text-yellow-300 rounded-full text-[11px] font-semibold">Veículo à Direita</span>
                </div>
            </div>
        </div>

        <!-- SLIDE 5: CLASSIFICAÇÃO DAS VIAS E VELOCIDADES -->
        <div class="slide-layout absolute inset-0 p-6 md:p-12 flex flex-col justify-center opacity-0 pointer-events-none transition-all duration-500 transform translate-x-12" id="slide-5">
            <div class="flex items-center justify-between mb-2">
                <h2 class="scaled-text-h2 font-title font-bold text-[var(--text-primary)]">Classificação de Vias & Velocidades Máximas</h2>
                <button onclick="toggleAudio()" class="slide-audio-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-previa-teal/20 text-previa-tealLight border border-previa-teal/30 hover:bg-previa-teal hover:text-white transition-all text-xs font-semibold cursor-pointer">
                    <i class="fa-solid fa-volume-high"></i> Ouvir Áudio
                </button>
            </div>
            <p class="text-[var(--text-secondary)] scaled-text-p mb-4">Limites regulamentares quando não houver placa de sinalização no local:</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 overflow-y-auto max-h-[380px] pr-2 custom-scrollbar">
                <!-- VIAS URBANAS -->
                <div class="bg-[var(--card-bg)] border border-[var(--card-border)] p-4 rounded-xl space-y-3">
                    <div class="flex items-center gap-2 text-previa-tealLight font-bold text-sm">
                        <i class="fa-solid fa-city"></i> VIAS URBANAS
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <div class="p-2 bg-black/20 rounded border border-white/5">
                            <span class="font-bold text-white block">Trânsito Rápido:</span>
                            <span class="text-previa-orange font-bold text-base">80 km/h</span>
                        </div>
                        <div class="p-2 bg-black/20 rounded border border-white/5">
                            <span class="font-bold text-white block">Arterial:</span>
                            <span class="text-previa-tealLight font-bold text-base">60 km/h</span>
                        </div>
                        <div class="p-2 bg-black/20 rounded border border-white/5">
                            <span class="font-bold text-white block">Coletora:</span>
                            <span class="text-yellow-400 font-bold text-base">40 km/h</span>
                        </div>
                        <div class="p-2 bg-black/20 rounded border border-white/5">
                            <span class="font-bold text-white block">Local:</span>
                            <span class="text-green-400 font-bold text-base">30 km/h</span>
                        </div>
                    </div>
                </div>

                <!-- VIAS RURAIS -->
                <div class="bg-[var(--card-bg)] border border-[var(--card-border)] p-4 rounded-xl space-y-3">
                    <div class="flex items-center gap-2 text-previa-orange font-bold text-sm">
                        <i class="fa-solid fa-mountain-sun"></i> VIAS RURAIS
                    </div>
                    <div class="space-y-2 text-xs">
                        <div class="p-2 bg-black/20 rounded border border-white/5 flex justify-between items-center">
                            <div>
                                <span class="font-bold text-white block">Rodovias de Pista Dupla:</span>
                                <span class="text-slate-400 text-[10px]">Autos/Motos: 110km/h | Demais: 90km/h</span>
                            </div>
                            <span class="text-previa-tealLight font-bold text-lg">110 / 90</span>
                        </div>
                        <div class="p-2 bg-black/20 rounded border border-white/5 flex justify-between items-center">
                            <div>
                                <span class="font-bold text-white block">Rodovias de Pista Simples:</span>
                                <span class="text-slate-400 text-[10px]">Autos/Motos: 100km/h | Demais: 90km/h</span>
                            </div>
