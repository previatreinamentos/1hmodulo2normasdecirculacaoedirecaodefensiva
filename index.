            "5. Limites de Velocidade",
            "6. Desafio: Fato ou Fake",
            "7. As 6 Condições Adversas",
            "8. Aquaplanagem e Perigos",
            "9. Distâncias na Condução",
            "10. Regra dos 2 Segundos",
            "11. Classificador de Riscos",
            "12. Ultrapassagens Seguras",
            "13. Faróis e Iluminação",
            "14. Veículos de Emergência",
            "15. Pedestres e Vulneráveis",
            "16. Manutenção Preventiva",
            "17. Estudo de Caso Prático",
            "18. Encerramento Módulo 2"
        ];

        for (let i = 1; i <= totalSlides; i++) {
            const opt = document.createElement('option');
            opt.value = i;
            opt.innerText = slideTitles[i-1] || `Slide ${i}`;
            select.appendChild(opt);
        }
    }

    function changeFontSize(delta) {
        fontScale = Math.max(0.8, Math.min(1.4, fontScale + delta));
        document.documentElement.style.setProperty('--font-scale', fontScale);
    }

    function toggleTheme() {
        isDarkMode = !isDarkMode;
        const wrapper = document.getElementById('presentation-wrapper');
        if (isDarkMode) {
            wrapper.classList.remove('light-theme');
        } else {
            wrapper.classList.add('light-theme');
        }
    }

    function getGooglePtBrFemaleVoice() {
        if (!('speechSynthesis' in window)) return null;
        const voices = window.speechSynthesis.getVoices();
        
        let googleVoice = voices.find(v => v.name.includes('Google') && v.lang.replace('_', '-').includes('pt-BR'));
        if (googleVoice) return googleVoice;

        let femaleVoice = voices.find(v => 
            (v.name.includes('Luciana') || v.name.includes('Francisca') || v.name.includes('Yara') || v.name.includes('Maria') || v.name.includes('Female') || v.name.includes('feminino')) &&
            (v.lang.includes('pt') || v.lang.includes('BR'))
        );
        if (femaleVoice) return femaleVoice;

        let ptBrVoice = voices.find(v => v.lang.replace('_', '-').includes('pt-BR'));
        if (ptBrVoice) return ptBrVoice;

        return voices.find(v => v.lang.includes('pt')) || null;
    }

    if ('speechSynthesis' in window) {
        window.speechSynthesis.onvoiceschanged = () => {
            getGooglePtBrFemaleVoice();
        };
    }

    function setAudioRate(rate) {
        currentAudioRate = parseFloat(rate);
        if (isSpeaking) {
            speakSlide(currentSlide);
        }
    }

    function startAudioProgressBar(text) {
        stopAudioProgressBar();
        const bar = document.getElementById('audio-progress-bar');
        if (!bar) return;

        audioStartTime = Date.now();
        audioEstimatedSecs = Math.max(1, (text.length / 15) / currentAudioRate);

        audioProgressTimer = setInterval(() => {
            const elapsed = (Date.now() - audioStartTime) / 1000;
            const progress = Math.min(100, (elapsed / audioEstimatedSecs) * 100);
            bar.style.width = progress + '%';
        }, 100);
    }

    function stopAudioProgressBar() {
        if (audioProgressTimer) {
            clearInterval(audioProgressTimer);
            audioProgressTimer = null;
        }
        const bar = document.getElementById('audio-progress-bar');
        if (bar) bar.style.width = '0%';
    }

    function speakSlide(slideNum) {
        if (!('speechSynthesis' in window)) return;

        window.speechSynthesis.cancel();
        stopAudioProgressBar();

        const text = slideAudios[slideNum] || slideAudios[currentSlide];
        if (!text) return;

        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'pt-BR';
        utterance.rate = currentAudioRate;
        utterance.pitch = 1.0;

        const selectedVoice = getGooglePtBrFemaleVoice();
        if (selectedVoice) {
            utterance.voice = selectedVoice;
        }

        utterance.onstart = function() {
            isSpeaking = true;
            updateAudioUI(true);
            startAudioProgressBar(text);
        };

        utterance.onboundary = function(event) {
            if (event.name === 'word' && text.length > 0) {
                const pct = Math.min(100, Math.max(0, (event.charIndex / text.length) * 100));
                const bar = document.getElementById('audio-progress-bar');
                if (bar) bar.style.width = pct + '%';
            }
        };

        utterance.onend = function() {
            isSpeaking = false;
            updateAudioUI(false);
            stopAudioProgressBar();
        };

        utterance.onerror = function() {
            isSpeaking = false;
            updateAudioUI(false);
            stopAudioProgressBar();
        };

        window.speechSynthesis.speak(utterance);
    }

    function stopAudio() {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
        }
        isSpeaking = false;
        updateAudioUI(false);
        stopAudioProgressBar();
    }

    function toggleAudio() {
        if (isSpeaking) {
            stopAudio();
        } else {
            speakSlide(currentSlide);
        }
    }

    function updateAudioUI(playing) {
        const btn = document.getElementById('audio-btn');
        const icon = document.getElementById('audio-icon');
        const pulse = document.getElementById('audio-pulse');
        
        if (playing) {
            if (icon) icon.className = 'fa-solid fa-volume-xmark text-sm text-previa-orange';
            if (pulse) pulse.classList.remove('hidden');
            if (btn) btn.classList.add('border-previa-orange', 'bg-orange-50');
        } else {
            if (icon) icon.className = 'fa-solid fa-volume-high text-sm';
            if (pulse) pulse.classList.add('hidden');
            if (btn) btn.classList.remove('border-previa-orange', 'bg-orange-50');
        }

        document.querySelectorAll('.slide-audio-btn').forEach(b => {
            if (playing) {
                b.classList.add('bg-previa-orange', 'text-white');
                b.innerHTML = '<i class="fa-solid fa-pause"></i> Pausar Áudio';
            } else {
                b.classList.remove('bg-previa-orange', 'text-white');
                b.innerHTML = '<i class="fa-solid fa-volume-high"></i> Ouvir Áudio';
            }
        });
    }

    function initFactGame() {
        currentFactIndex = 0;
        factScore = 0;
        renderFactCard();
    }

    function renderFactCard() {
        if (currentFactIndex >= factQuestions.length) {
            currentFactIndex = 0;
        }
        const q = factQuestions[currentFactIndex];
        document.getElementById('fact-card-counter').innerText = `Questão ${currentFactIndex + 1} de ${factQuestions.length}`;
        document.getElementById('fact-text').innerText = q.text;
        document.getElementById('fact-score').innerText = `Pontos: ${factScore}`;
        document.getElementById('game-fact-feedback').classList.add('hidden');
    }

    function answerFact(userChoice) {
        const q = factQuestions[currentFactIndex];
        const isCorrect = (userChoice === q.isFact);
        
        const feedbackModal = document.getElementById('game-fact-feedback');
        const icon = document.getElementById('fact-feedback-icon');
        const title = document.getElementById('fact-feedback-title');
        const desc = document.getElementById('fact-feedback-desc');

        if (isCorrect) {
            factScore += 10;
            icon.innerHTML = '<i class="fa-solid fa-circle-check text-green-400"></i>';
            title.innerText = 'Resposta Correta!';
        } else {
            icon.innerHTML = '<i class="fa-solid fa-circle-xmark text-red-400"></i>';
            title.innerText = 'Incorreto!';
        }
        
        desc.innerText = q.feedbackText;
        document.getElementById('fact-score').innerText = `Pontos: ${factScore}`;
        feedbackModal.classList.remove('hidden');
    }

    function nextFact() {
        currentFactIndex++;
        if (currentFactIndex >= factQuestions.length) {
            currentFactIndex = 0;
        }
        renderFactCard();
    }

    function initRiskGame() {
        currentRiskIndex = 0;
        riskScore = 0;
        renderRiskCard();
    }

    function renderRiskCard() {
        const container = document.getElementById('classifier-sign-area');
        if (currentRiskIndex >= riskSituations.length) {
            container.innerHTML = `<span class="text-green-400 font-bold text-sm">Parabéns! Você completou o classificador de riscos!</span>`;
            document.getElementById('classifier-score').innerText = `Acertos Finais: ${riskScore} / ${riskSituations.length}`;
            return;
        }
        const current = riskSituations[currentRiskIndex];
        container.innerHTML = `<span class="text-white font-bold text-sm">${current.text}</span>`;
        document.getElementById('classifier-score').innerText = `Acertos: ${riskScore} / ${riskSituations.length}`;
    }

    function classifySituation(category) {
        if (currentRiskIndex >= riskSituations.length) return;
        
        if (riskSituations[currentRiskIndex].category === category) {
            riskScore++;
        }
        currentRiskIndex++;
        renderRiskCard();
    }

    function checkCase(isCorrect) {
        const fb = document.getElementById('case-feedback');
        fb.classList.remove('hidden', 'bg-green-500/20', 'text-green-300', 'bg-red-500/20', 'text-red-300');
        if (isCorrect) {
            fb.classList.add('bg-green-500/20', 'text-green-300');
            fb.innerText = 'Correto! Sob chuva forte, a visibilidade cai drasticamente e o risco de aquaplanagem aumenta. Aumentar a distância de seguimento é a conduta mais segura.';
        } else {
            fb.classList.add('bg-red-500/20', 'text-red-300');
            fb.innerText = 'Incorreto! Tentar ultrapassar sob baixa visibilidade e chuva forte coloca você em altíssimo risco de colisão frontal.';
        }
    }
</script>

